<UserControl
  x:Class="VPet.ModMaker.Views.FontView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:m="clr-namespace:VPet.ModMaker.Models"
  mc:Ignorable="d"
  d:DesignHeight="450"
  d:DesignWidth="800"
  d:DataContext="{d:DesignInstance vm:FontEditViewModel}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <TextBox
        pu:TextBoxHelper.Watermark="{ll:Str 搜索}"
        Style="{StaticResource StandardTextBoxStyle}"
        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
      />
    </Grid>
    <DataGrid
      x:Name="DataGrid"
      Grid.Row="1"
      d:ItemsSource="{d:SampleData ItemCount=5}"
      d:SelectedIndex="0"
      ItemsSource="{Binding Fonts.FilteredList}"
      MouseDoubleClick="DataGrid_MouseDoubleClick"
      FrozenColumnCount="1"
      Style="{DynamicResource ModMaker_ModelsDataGrid}"
    >
      <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
          <Setter Property="Height" Value="64" />
          <Setter Property="Tag" Value="{Binding}" />
          <Setter
            Property="ContextMenu"
            Value="{StaticResource ModMaker_DataGridRowRemovesContextMenu}"
          />
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn
          MaxWidth="200"
          Binding="{Binding Name}"
          CanUserSort="True"
          ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
          Header="{ll:Str 名称}"
          IsReadOnly="True"
          SortMemberPath="Name"
        />
        <DataGridTextColumn
          Binding="{Binding SupportedCultures}"
          CanUserSort="True"
          ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
          Header="{ll:Str 支持的文化}"
          IsReadOnly="True"
        />
        <DataGridTextColumn
          Binding="{Binding Source={x:Static m:FontModel.SampleText}}"
          CanUserSort="True"
          FontSize="16"
          Header="{ll:Str 示例文本}"
          IsReadOnly="True"
        >
          <DataGridTextColumn.ElementStyle>
            <Style
              TargetType="{x:Type TextBlock}"
              BasedOn="{StaticResource ModMaker_TextBlockLeftCenter}"
            >
              <Setter Property="FontFamily" Value="{Binding Font}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Button
      Grid.Row="1"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Command="{Binding AddCommand}"
      Content="➕"
      Style="{DynamicResource ModMaker_AddButton}"
    />
  </Grid>
</UserControl>
