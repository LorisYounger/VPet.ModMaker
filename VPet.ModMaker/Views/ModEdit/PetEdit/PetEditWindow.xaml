                x:Name="ToggleButton_TouchBody"
                Content="{ll:Str 显示位置}"
                Style="{StaticResource StandardToggleButtonStyle}"
                Height="30"
                Grid.Row="1"
                pu:ToggleButtonHelper.CheckedContent="{ll:Str 隐藏位置}"
              />
              <Grid Grid.Column="1" Grid.RowSpan="2" Width="300" HorizontalAlignment="Right">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="X:" Style="{DynamicResource ModMaker_LabelCenterStyle}" />
                <pu:NumberInput
