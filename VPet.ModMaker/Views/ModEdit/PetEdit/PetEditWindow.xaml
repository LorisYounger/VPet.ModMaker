                      Style="{DynamicResource ModMaker_LabelCenterStyle}"
                      Width="30"
                    />
                    <pu:NumberInput
                      IsSnapToIntervalEnabled="False"
                      Grid.Row="1"
                      Grid.Column="3"
                      Value="{Binding Pet.TouchRaisedRectangleLocation.PoorCondition.Height, Mode=TwoWay}"
                      Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    />
                  </Grid>
                </Grid>
              </Border>
              <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 生病状态}"
                  />
                  <ToggleButton
                    x:Name="ToggleButton_TouchRaisedRectangleLocation_IllState"
                    d:IsChecked="True"
