<?xml version="1.0" encoding="utf-8"?>
<pu:WindowX
  x:Class="VPet.ModMaker.Views.PetEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  Title="{ll:Str 编辑宠物}"
  Width="1280"
  Height="720"
  MinWidth="800"
  MinHeight="600"
  d:DataContext="{d:DesignInstance Type=vm:PetEditViewModel}"
  d:Height="1000"
  d:Width="800"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource BaseWindowXStyle}"
  mc:Ignorable="d"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
        <ResourceDictionary>
          <Style
            x:Key="Label_ThouchRectangleLocation"
            BasedOn="{StaticResource {x:Type Label}}"
            TargetType="Label"
          >
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#19FF0000" />
            <Setter Property="BorderBrush" Value="Red" />
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding Tag, RelativeSource={RelativeSource Mode=Self}}"
                Value="True"
              >
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="ID" />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="ID"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Pet.ID, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 标签}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="{ll:Str '标签, 用英文逗号分隔'}"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Pet.Tags, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 名称}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="{ll:Str 名称}"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Pet.Name, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 宠物名称}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="{ll:Str 宠物名称}"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Pet.PetName, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="120" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid RowDefinitions="40,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 描述}"
              />
              <TextBox
                Grid.Row="1"
                Margin="0,0,0,5"
                pu:TextBoxHelper.Watermark="{ll:Str 描述}"
                Style="{DynamicResource ModMaker_TextBoxWrapStyle}"
                Text="{Binding Pet.Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
              />
            </Grid>
          </Border>
          <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 头部触碰范围}"
              />
              <ToggleButton
                Height="30"
                Grid.Row="1"
                x:Name="ToggleButton_TouchHead"
                d:IsChecked="True"
                Content="{ll:Str 显示位置}"
                pu:ToggleButtonHelper.CheckedContent="{ll:Str 隐藏位置}"
                Style="{StaticResource StandardToggleButtonStyle}"
              />
              <Grid
                Grid.RowSpan="2"
                Width="300"
                Grid.Column="1"
                RowDefinitions="*,*"
                HorizontalAlignment="Right"
                ColumnDefinitions="Auto,*,Auto,*"
              >
                <Label Style="{DynamicResource ModMaker_LabelCenterStyle}" Content="X:" />
                <pu:NumberInput
                  IsSnapToIntervalEnabled="False"
                  Grid.Column="1"
                  d:Value="100"
                  Value="{Binding Pet.TouchHeadRectangleLocation.X}"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                />
                <Label
                  Width="30"
                  Style="{DynamicResource ModMaker_LabelCenterStyle}"
                  Grid.Column="2"
                  Content="Y:"
                />
                <pu:NumberInput
                  IsSnapToIntervalEnabled="False"
                  Grid.Column="3"
                  d:Value="100"
                  Value="{Binding Pet.TouchHeadRectangleLocation.Y, Mode=TwoWay}"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                />
                <Label
                  Width="30"
                  Grid.Row="1"
                  Style="{DynamicResource ModMaker_LabelCenterStyle}"
                  Content="W:"
                />
                <pu:NumberInput
                  IsSnapToIntervalEnabled="False"
                  Grid.Row="1"
                  Grid.Column="1"
                  d:Value="100"
                  Value="{Binding Pet.TouchHeadRectangleLocation.Width, Mode=TwoWay}"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                />
                <Label
                  Width="30"
                  Grid.Row="1"
                  Grid.Column="2"
                  Style="{DynamicResource ModMaker_LabelCenterStyle}"
                  Content="H:"
                />
                <pu:NumberInput
                  IsSnapToIntervalEnabled="False"
                  Grid.Row="1"
                  Grid.Column="3"
                  d:Value="100"
                  Value="{Binding Pet.TouchHeadRectangleLocation.Height, Mode=TwoWay}"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                />
              </Grid>
            </Grid>
          </Border>
          <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 身体触碰范围}"
              />
