                    />
                    <Label
                      Grid.Column="2"
                      Content="Y:"
                      Style="{DynamicResource ModMaker_LabelCenterStyle}"
                      Width="30"
                    />
                    <pu:NumberInput
                      IsSnapToIntervalEnabled="False"
                      Grid.Column="3"
                      Value="{Binding Pet.TouchRaisedRectangleLocation.PoorCondition.Y, Mode=TwoWay}"
                      Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    />
                    <Label
                      Grid.Row="1"
                      Content="W:"
                      Style="{DynamicResource ModMaker_LabelCenterStyle}"
                      Width="30"
                    />
                    <pu:NumberInput
                      IsSnapToIntervalEnabled="False"
                      Grid.Row="1"
                      Grid.Column="1"
                      Value="{Binding Pet.TouchRaisedRectangleLocation.PoorCondition.Width, Mode=TwoWay}"
