                </Grid>
              </Border>
            </StackPanel>
          </GroupBox>
          <GroupBox
            Margin="0,5,0,0"
            Header="{ll:Str 提起点位}"
            Style="{DynamicResource ModMaker_GroupBoxBaseStyle}"
          >
            <StackPanel>
