<UserControl
  x:Class="VPet.ModMaker.Views.WorkView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:h="https://hkw.com/wpf"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:WorkEditViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox
        pu:TextBoxHelper.Watermark="{ll:Str 搜索}"
        IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
      />

      <ComboBox
        Grid.Column="1"
        MinWidth="150"
        ItemsSource="{x:Static vm:WorkEditViewModel.SearchTargets}"
        SelectedItem="{Binding CurrentSearchTarget}"
        Style="{StaticResource StandardComboBoxStyle}"
        ToolTip="{ll:Str 搜索目标}"
        IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
      />
      <Button
        Grid.Column="2"
        MinWidth="100"
        IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
        Command="{Binding FixOverLoadForAllWorkCommand}"
        Content="{ll:Str 修复超模}"
        Style="{StaticResource ModMaker_ButtonBaseStyle}"
      />
      <ComboBox
        x:Name="ComboBox_Pet"
        Grid.Column="3"
        MinWidth="150"
        pu:ComboBoxHelper.Watermark="{ll:Str 选择宠物}"
        ItemsSource="{Binding ModInfo.Pets.FilteredList}"
        SelectedItem="{Binding ModInfo.CurrentPet}"
        Style="{StaticResource StandardComboBoxStyle}"
      >
        <ComboBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
            <Setter Property="ToolTip" Value="{Binding Name}" />
          </Style>
        </ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ID}" />
              <TextBlock Text=" " />
              <TextBlock
                Text="{ll:Str '(来自本体)'}"
                Visibility="{Binding FromMain, Converter={StaticResource FalseToCollapsedConverter}}"
              />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid
      Grid.Row="1"
      IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
    >
      <DataGrid
        d:ItemsSource="{d:SampleData ItemCount=5}"
        d:SelectedIndex="0"
        ItemsSource="{Binding Works.FilteredList}"
        MouseDoubleClick="DataGrid_MouseDoubleClick"
        FrozenColumnCount="1"
        Style="{DynamicResource ModMaker_ModelsDataGrid}"
      >
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
            <Setter Property="Height" Value="64" />
            <Setter Property="Tag" Value="{Binding}" />
            <Setter
              Property="ContextMenu"
              Value="{StaticResource ModMaker_DataGridRowEditAndRemovesContextMenu}"
            />
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn
            Binding="{Binding ID}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="ID"
            IsReadOnly="True"
            SortMemberPath="ID"
          />
          <DataGridTextColumn
            Binding="{Binding Name}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 工作名称}"
            IsReadOnly="True"
            SortMemberPath="Name"
          />
          <DataGridTextColumn
            Binding="{Binding Type, Converter={StaticResource EnumToEnumInfoConverter}}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 工作类型}"
            IsReadOnly="True"
            SortMemberPath="WorkType"
          />
          <DataGridTextColumn
            Binding="{Binding Graph}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 动画名称}"
            IsReadOnly="True"
            SortMemberPath="Graph"
          />
          <DataGridTextColumn
            Binding="{Binding IsOverLoad}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 是否超模}"
            IsReadOnly="True"
            SortMemberPath="Graph"
          />
          <DataGridTextColumn
            Binding="{Binding MoneyBase}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 基本倍率}"
            IsReadOnly="True"
            SortMemberPath="MoneyBase"
          />
          <!--<DataGridTextColumn
            Binding="{Binding MoneyLevel}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 等级倍率}"
            IsReadOnly="True"
            SortMemberPath="MoneyLevel" />-->
          <DataGridTextColumn
            Binding="{Binding StrengthFood}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 饱食度消耗倍率}"
            IsReadOnly="True"
            SortMemberPath="StrengthFood"
          />
          <DataGridTextColumn
            Binding="{Binding StrengthDrink}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 口渴度消耗倍率}"
            IsReadOnly="True"
            SortMemberPath="StrengthDrink"
          />
          <DataGridTextColumn
            Binding="{Binding Feeling}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 心情消耗倍率}"
            IsReadOnly="True"
            SortMemberPath="Feeling"
          />
          <DataGridTextColumn
            Binding="{Binding LevelLimit}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 等级限制}"
            IsReadOnly="True"
            SortMemberPath="LevelLimit"
          />
          <DataGridTextColumn
            Binding="{Binding Time}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 花费时间}"
            IsReadOnly="True"
            SortMemberPath="Time"
          />
          <DataGridTextColumn
            Binding="{Binding FinishBonus}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 奖励倍率}"
            IsReadOnly="True"
            SortMemberPath="FinishBonus"
          />
        </DataGrid.Columns>
      </DataGrid>
      <Button
        Grid.Row="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Command="{Binding AddCommand}"
        Content="➕"
        Style="{DynamicResource ModMaker_AddButton}"
      />
    </Grid>
  </Grid>
</UserControl>
