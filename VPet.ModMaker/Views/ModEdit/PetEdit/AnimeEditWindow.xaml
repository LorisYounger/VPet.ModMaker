              </MultiBinding>
            </TabItem.Header>
            <ListBox
              d:ItemsSource="{d:SampleData ItemCount=5}"
              d:SelectedIndex="0"
              Style="{DynamicResource SideMenuListBoxStyle}"
              ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
              ItemsSource="{Binding Anime.HappyAnimes}"
              SelectedItem="{Binding CurrentAnimeModel}"
            />
          </TabItem>
          <TabItem d:Header="Nomal (0)" Tag="Nomal">
            <TabItem.Header>
              <MultiBinding
                Converter="{StaticResource StringFormatConverter}"
                ConverterParameter="{}{0} ({1})"
              >
                <Binding Path="Tag" RelativeSource="{RelativeSource Mode=Self}" />
                <Binding Path="Anime.NomalAnimes.Count" />
              </MultiBinding>
            </TabItem.Header>
            <ListBox
              d:ItemsSource="{d:SampleData ItemCount=5}"
              d:SelectedIndex="0"
              Style="{DynamicResource SideMenuListBoxStyle}"
              ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
              ItemsSource="{Binding Anime.NomalAnimes}"
              SelectedItem="{Binding CurrentAnimeModel}"
            />
          </TabItem>
          <TabItem d:Header="PoorCondition (0)" Tag="PoorCondition">
            <TabItem.Header>
              <MultiBinding
                Converter="{StaticResource StringFormatConverter}"
                ConverterParameter="{}{0} ({1})"
              >
                <Binding Path="Tag" RelativeSource="{RelativeSource Mode=Self}" />
                <Binding Path="Anime.PoorConditionAnimes.Count" />
              </MultiBinding>
            </TabItem.Header>
            <ListBox
              d:ItemsSource="{d:SampleData ItemCount=5}"
              d:SelectedIndex="0"
              Style="{DynamicResource SideMenuListBoxStyle}"
              ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
              ItemsSource="{Binding Anime.PoorConditionAnimes}"
              SelectedItem="{Binding CurrentAnimeModel}"
            />
          </TabItem>
          <TabItem d:Header="Ill (0)" Tag="Ill">
            <TabItem.Header>
              <MultiBinding
                Converter="{StaticResource StringFormatConverter}"
                ConverterParameter="{}{0} ({1})"
              >
                <Binding Path="Tag" RelativeSource="{RelativeSource Mode=Self}" />
                <Binding Path="Anime.IllAnimes.Count" />
              </MultiBinding>
            </TabItem.Header>
            <ListBox
              d:ItemsSource="{d:SampleData ItemCount=5}"
              d:SelectedIndex="0"
              Style="{DynamicResource SideMenuListBoxStyle}"
              ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
              ItemsSource="{Binding Anime.IllAnimes}"
              SelectedItem="{Binding CurrentAnimeModel}"
            />
          </TabItem>
        </TabControl>-->
        <Button
          Grid.Row="1"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Command="{Binding AddAnimeCommand}"
          CommandParameter="{Binding CurrentMode}"
          Content="➕"
          Style="{DynamicResource ModMaker_AddButton}"
        />
      </Grid>
    </Grid>
    <Border
      Margin="0,5,0,5"
      Grid.Row="1"
      Height="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <Grid
      IsHitTestVisible="{Binding Playing, Converter={StaticResource BoolInverter}}"
      IsEnabled="{Binding CurrentAnimeModel,Converter={StaticResource NullToFalseConverter}}"
      Grid.Row="2"
      RowDefinitions="Auto,*"
    >
      <Grid Margin="0,0,0,5" ColumnDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,Auto">
          <TextBox
            Grid.Column="0"
            Width="200"
            VerticalAlignment="Center"
            pu:TextBoxHelper.Watermark="{ll:Str 动画ID(非必要)}"
            FontSize="14"
            Style="{StaticResource StandardTextBoxStyle}"
            Text="{Binding CurrentAnimeModel.ID, UpdateSourceTrigger=PropertyChanged}"
          />
          <ComboBox
            Grid.Column="1"
            Width="200"
            Margin="10,0,0,0"
            ItemsSource="{Binding Source={x:Static m:AnimeTypeModel.AnimatTypes}, Converter={StaticResource EnumsToEnumInfosConverter}}"
            SelectedItem="{Binding CurrentAnimeModel.AnimeType, Converter={StaticResource EnumToEnumInfoConverter}}"
            Style="{StaticResource StandardComboBoxStyle}"
            Visibility="{Binding DataContext.HasMultiType, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}, Converter={StaticResource FalseToCollapsedConverter}}"
          />
        </Grid>
        <Grid Grid.Column="1" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto">
          <Button
            Grid.Column="0"
            Width="100"
            Margin="5,0,5,0"
            Style="{DynamicResource ModMaker_ButtonBaseStyle}"
            Command="{Binding AddImageCommand}"
            CommandParameter="{Binding CurrentAnimeModel}"
            Content="{ll:Str 添加图片}"
          />
          <Button
            Grid.Column="1"
            Width="100"
            Margin="5,0,5,0"
            Style="{DynamicResource ModMaker_ButtonBaseStyle}"
            Command="{Binding ClearImageCommand}"
            CommandParameter="{Binding CurrentAnimeModel}"
            Content="{ll:Str 清空图片}"
          />
        </Grid>
      </Grid>
      <ListBox
        VerticalAlignment="Top"
        x:Name="Images"
        Height="190"
        Grid.Row="1"
        d:ItemsSource="{d:SampleData ItemCount=5}"
        AllowDrop="True"
        Drop="ListBox_Images_Drop"
        ItemsSource="{Binding CurrentAnimeModel.Images}"
        PreviewMouseMove="ListBox_Images_PreviewMouseMove"
        PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollBarVisibility="Hidden"
        pu:ScrollBarHelper.ThumbBackground="{DynamicResource SecondaryLight}"
        pu:ScrollViewerHelper.ScrollBarPosition="Inside"
        pu:ScrollViewerHelper.ScrollBarThickness="3"
        SelectedItem="{Binding CurrentImageModel}"
        SelectionChanged="ListBox_Images_SelectionChanged"
        pu:ListBoxHelper.CornerRadius="4"
        d:SelectedIndex="0"
        BorderThickness="1.5"
        pu:ListBoxHelper.ItemsSelectedBackground="{DynamicResource  PrimaryLighter}"
        BorderBrush="{DynamicResource DARKPrimary}"
      >
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid
              RowDefinitions="Auto,*"
              Background="Transparent"
              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
            >
              <!--<Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem
                    d:Header="修改图片"
                    Command="{Binding PlacementTarget.Tag.ChangeImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    CommandParameter="{Binding}"
                    Header="{ll:Str 修改图片}"
                  />
                  <MenuItem
                    d:Header="删除图片"
                    Command="{Binding PlacementTarget.Tag.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    CommandParameter="{Binding}"
                    Header="{ll:Str 删除图片}"
                  />
                </ContextMenu>
              </Grid.ContextMenu>-->
              <Image Width="150" Height="150" d:DataContext="" Source="{Binding Image}">
                <Image.ToolTip>
                  <Image Width="250" Height="250" Source="{Binding Image}" />
                </Image.ToolTip>
              </Image>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <Label
                  FontSize="12"
                  Height="25"
                  Padding="5,0,5,0"
                  VerticalContentAlignment="Center"
                  Style="{DynamicResource ModMaker_LabelCenterStyle}"
                  Content="{ll:Str 持续时间}"
                />
                <pu:NumberInput
                  Height="25"
                  Grid.Column="1"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding Duration}"
                />
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <!--<Grid Margin="0,5,0,0" Grid.Row="3" ColumnDefinitions="*,*">
      <Button
        x:Name="Button_Yes"
        Width="200"
        Click="Button_Yes_Click"
        Content="{ll:Str 确定}"
        Style="{StaticResource MyThemedButtonStyle}"
      />
      <Button
        x:Name="Button_Cancel"
        Grid.Column="1"
        Width=" 200"
        Click="Button_Cancel_Click"
        Content="{ll:Str 取消}"
        Style="{StaticResource Button_Cancel}"
      />
    </Grid>-->
  </Grid>
