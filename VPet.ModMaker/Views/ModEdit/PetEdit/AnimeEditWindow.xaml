<pu:WindowX
  x:Class="VPet.ModMaker.Views.AnimeEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:m="clr-namespace:VPet.ModMaker.Models"
  Title="{ll:Str 编辑动画}"
  Width="1280"
  Height="720"
  MinWidth="800"
  MinHeight="600"
  d:DataContext="{d:DesignInstance Type=vm:AnimeEditViewModel}"
  d:Width="800"
  d:Height="600"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Window.Resources>
    <Style
      x:Key="Anime_ListBoxItemStyle"
      BasedOn="{StaticResource {x:Type ListBoxItem}}"
      TargetType="ListBoxItem"
    >
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter
        Property="Tag"
        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
      />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid ColumnDefinitions="100,100">
              <TextBlock
                Text="{Binding ID}"
                Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
              />
              <TextBlock
                Text="{Binding Images.Count}"
                Grid.Column="1"
                Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
              />
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem, Mode=FindAncestor}}">
            <MenuItem
              Command="{Binding PlacementTarget.Tag.RemoveAnimeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
              CommandParameter="{Binding}"
              Header="{ll:Str 删除此项}"
            />
          </ContextMenu>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="10" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="300,Auto,*">
      <Grid RowDefinitions="*,Auto">
        <Border
          BorderBrush="{DynamicResource DARKPrimaryLight}"
          BorderThickness="1.5"
          CornerRadius="4"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Background="Transparent"
        >
          <Image
            Margin="1"
            VerticalAlignment="Top"
            Width="250"
            Height="250"
            Source="{Binding CurrentImageModel.Image}"
          >
            <Image.ToolTip>
              <Image Width="500" Height="500" Source="{Binding CurrentImageModel.Image}" />
            </Image.ToolTip>
          </Image>
        </Border>
        <StackPanel Grid.Row="1">
          <Grid Margin="0,5,0,5" Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
              Width="100"
              Command="{Binding StopCommand}"
              Content="{ll:Str 停止}"
              Style="{StaticResource ModMaker_ButtonBaseStyle}"
            />
            <Button
              Grid.Column="1"
              Width="100"
              Command="{Binding StartCommand}"
              Content="{ll:Str 播放}"
              Style="{StaticResource ModMaker_ButtonBaseStyle}"
            />
            <ToggleButton
              Grid.Column="2"
              Width="100"
              Content="{ll:Str 循环}"
              IsChecked="{Binding Loop}"
              Style="{StaticResource StandardToggleButtonStyle}"
            />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <Label Content="{ll:Str 动画类型}" Style="{StaticResource ThemedLabelStyle}" />
            <TextBlock
              Grid.Column="1"
              Padding="5"
              d:Text="Type"
              FontSize="14"
              Style="{StaticResource ModMaker_TextBlockLeftCenter}"
              Text="{Binding Anime.GraphType}"
            />
            <Label
              Grid.Row="1"
              Content="{ll:Str 动画名称}"
              Style="{StaticResource ThemedLabelStyle}"
              Visibility="{Binding HasAnimeName, Converter={StaticResource FalseToCollapsedConverter}}"
            />
            <TextBox
              Grid.Row="1"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 动画名称}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding Anime.Name, UpdateSourceTrigger=PropertyChanged}"
              Visibility="{Binding HasAnimeName, Converter={StaticResource FalseToCollapsedConverter}}"
            />
          </Grid>
        </StackPanel>
      </Grid>
      <Border
        Margin="5,0,5,0"
        Grid.Column="1"
        Width="2"
        CornerRadius="2"
        Background="{DynamicResource SecondaryLight}"
        Opacity="0.3"
      />
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <ListBox
          x:Name="ModeTypes"
          SelectedIndex="0"
          PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
          Style="{DynamicResource SideMenuListBoxStyle}"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Tag="{Binding Anime.HappyAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModType_Happy'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.HappyAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.NomalAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_Nomal'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.NomalAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.PoorConditionAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_PoorCondition'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.PoorConditionAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.IllAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_Ill'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.IllAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
        </ListBox>
        <ListBox
          Grid.Row="1"
          x:Name="Animes"
          d:ItemsSource="{d:SampleData ItemCount=5}"
          d:SelectedIndex="0"
          Style="{DynamicResource SideMenuListBoxStyle}"
          ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
          ItemsSource="{Binding SelectedItem.Tag, ElementName=ModeTypes}"
          SelectedItem="{Binding CurrentAnimeModel}"
        />
        <!--<TabControl
          pu:TabControlHelper.HeaderPanelCornerRadius="4"
          pu:TabControlHelper.HeaderPanelShadowColor="Aqua"
          pu:TabControlHelper.ItemsBackground="{StaticResource DARKPrimary}"
          pu:TabControlHelper.ItemsHoverBackground="{StaticResource DARKPrimaryLight}"
          pu:TabControlHelper.ItemsSelectedBackground="{StaticResource DARKPrimaryLighter}"
          Foreground="{StaticResource DARKPrimaryText}"
        >
          <TabItem d:Header="Happy (0)" Tag="Happy">
            <TabItem.Header>
              <MultiBinding
                Converter="{StaticResource StringFormatConverter}"
                ConverterParameter="{}{0} ({1})"
              >
                <Binding Path="Tag" RelativeSource="{RelativeSource Mode=Self}" />
