<UserControl
  x:Class="VPet.ModMaker.Views.MoveView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:MoveEditViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox
        pu:TextBoxHelper.Watermark="{ll:Str 搜索动画}"
        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
      />
      <ComboBox
        x:Name="ComboBox_Pet"
        Grid.Column="2"
        MinWidth="200"
        pu:ComboBoxHelper.Watermark="{ll:Str 选择宠物}"
        ItemsSource="{Binding ModInfo.Pets.FilteredList}"
        SelectedItem="{Binding ModInfo.CurrentPet}"
        Style="{StaticResource StandardComboBoxStyle}"
      >
        <ComboBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
            <Setter Property="ToolTip" Value="{Binding Name}" />
          </Style>
        </ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ID}" />
              <TextBlock Text=" " />
              <TextBlock
                Text="{ll:Str '(来自本体)'}"
                Visibility="{Binding FromMain, Converter={StaticResource FalseToCollapsedConverter}}"
              />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid
      Grid.Row="1"
      IsEnabled="{Binding CurrentPet, Converter={StaticResource NullToFalseConverter}}"
    >
      <DataGrid
        d:ItemsSource="{d:SampleData ItemCount=5}"
        d:SelectedIndex="0"
        ItemsSource="{Binding Moves.FilteredList}"
        MouseDoubleClick="DataGrid_MouseDoubleClick"
        FrozenColumnCount="1"
        Style="{DynamicResource ModMaker_ModelsDataGrid}"
      >
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
            <Setter Property="Height" Value="50" />
            <Setter Property="Tag" Value="{Binding}" />
            <Setter
              Property="ContextMenu"
              Value="{StaticResource ModMaker_DataGridRowEditAndRemovesContextMenu}"
            />
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn
            Binding="{Binding Graph}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 绑定动画}"
            IsReadOnly="True"
            SortMemberPath="Graph"
          />
          <DataGridTextColumn
            Binding="{Binding LocateType.Value, Converter={StaticResource EnumToEnumInfoConverter}}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 定位类型}"
            IsReadOnly="True"
            SortMemberPath="LocateType.Value"
          />
          <DataGridTextColumn
            Binding="{Binding TriggerType.Value, Converter={StaticResource EnumToEnumInfoConverter}}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 触发类型}"
            IsReadOnly="True"
            SortMemberPath="TriggerType.Value"
          />
          <DataGridTextColumn
            Binding="{Binding ModeType.Value, Converter={StaticResource EnumToEnumInfoConverter}}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 状态类型}"
            IsReadOnly="True"
            SortMemberPath="ModeType.Value"
          />
          <DataGridTextColumn
            Binding="{Binding Distance}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 移动距离}"
            IsReadOnly="True"
            SortMemberPath="Distance"
          />
          <DataGridTextColumn
            Binding="{Binding Interval}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 移动间隔}"
            IsReadOnly="True"
            SortMemberPath="Interval"
          />
          <DataGridTextColumn
            Binding="{Binding LocateLength}"
            CanUserSort="True"
            ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
            Header="{ll:Str 定位长度}"
            IsReadOnly="True"
            SortMemberPath="LocateLength"
          />
        </DataGrid.Columns>
      </DataGrid>
      <Button
        Grid.Row="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Command="{Binding AddCommand}"
        Content="➕"
        Style="{DynamicResource ModMaker_AddButton}"
      />
    </Grid>
  </Grid>
</UserControl>
