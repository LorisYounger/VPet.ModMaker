<pu:WindowX
  x:Class="VPet.ModMaker.Views.SelectGraphTypeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  Title="{ll:Str 选择动画类型}"
  Width="500"
  Height="300"
  MinWidth="500"
  MinHeight="300"
  WindowStartupLocation="CenterScreen"
  d:DataContext="{d:DesignInstance Type=vm:SelectGraphTypeViewModel}"
  mc:Ignorable="d"
  Style="{DynamicResource BaseWindowXStyle}"
>
  <Window.Resources>
    <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Width="300" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Label Content="{ll:Str 动画类型}" Style="{DynamicResource ModMaker_LabelCenterStyle}" />
      <ComboBox
        ItemsSource="{Binding GraphTypes}"
        SelectedItem="{Binding GraphType}"
        Style="{StaticResource StandardComboBoxStyle}"
      />
      <Label
        Content="{ll:Str 动画名称}"
        Style="{DynamicResource ModMaker_LabelCenterStyle}"
        Visibility="{Binding HasNameAnime, Converter={StaticResource FalseToCollapsedConverter}}"
      />
      <TextBox
        Style="{StaticResource StandardTextBoxStyle}"
        Text="{Binding AnimeName, UpdateSourceTrigger=PropertyChanged}"
        Visibility="{Binding HasNameAnime, Converter={StaticResource FalseToCollapsedConverter}}"
      />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="Button_Yes"
        Margin="10"
        Click="Button_Yes_Click"
        Content="{ll:Str 确定}"
        Style="{DynamicResource ThemedButtonStyle}"
      />
      <Button
        x:Name="Button_Cancel"
        Grid.Column="1"
        Margin="10"
        Click="Button_Cancel_Click"
        Content="{ll:Str 取消}"
        Style="{DynamicResource Button_Cancel}"
      />
    </Grid>
  </Grid>
</pu:WindowX>
