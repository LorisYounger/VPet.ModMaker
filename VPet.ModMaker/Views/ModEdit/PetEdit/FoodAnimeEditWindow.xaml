<pu:WindowX
  x:Class="VPet.ModMaker.Views.FoodAnimeEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:m="clr-namespace:VPet.ModMaker.Models"
  Title="{ll:Str 编辑动画}"
  Width="1280"
  Height="720"
  MinWidth="800"
  MinHeight="600"
  d:DataContext="{d:DesignInstance Type=vm:FoodAnimeEditViewModel}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
  Style="{DynamicResource BaseWindowXStyle}"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style
        x:Key="Anime_ListBoxItemStyle"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="ListBoxItem"
      >
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter
          Property="Tag"
          Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
        />
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <Grid ColumnDefinitions="100,100,100,100">
                <TextBlock
                  Text="{Binding ID}"
                  Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
                />
                <TextBlock
                  Text="{Binding FrontImages.Count}"
                  Grid.Column="1"
                  Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
                />
                <TextBlock
                  Text="{Binding BackImages.Count}"
                  Grid.Column="2"
                  Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
                />
                <TextBlock
                  Text="{Binding FoodLocations.Count}"
                  Grid.Column="3"
                  Style="{DynamicResource ModMaker_TextBlockLeftCenter}"
                />
              </Grid>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="10" ColumnDefinitions="400,Auto,*">
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid RowDefinitions="*,Auto">
        <Border
          BorderBrush="{DynamicResource DARKPrimaryLight}"
          BorderThickness="1.5"
          CornerRadius="4"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Background="Transparent"
        >
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem
                Command="{Binding ChangeFoodImageCommand}"
                Header="{ll:Str 替换测试食物图片}"
              />
              <MenuItem
                Command="{Binding ResetFoodImageCommand}"
                Header="{ll:Str 重置测试食物图片}"
              >
                <MenuItem.IsEnabled>
                  <MultiBinding Converter="{StaticResource NotEqualsConverter}">
                    <Binding Path="FoodImage" />
                    <Binding Path="DefaultFoodImage" />
                  </MultiBinding>
                </MenuItem.IsEnabled>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid>
            <Image
              x:Name="BackImage"
              Width="250"
              Height="250"
              Source="{Binding CurrentBackImage.Image}"
            />
            <Image
              MaxHeight="250"
              MaxWidth="250"
              x:Name="FoodImage"
              Height="{Binding Width, RelativeSource={RelativeSource Mode=Self}}"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Opacity="{Binding CurrentFoodLocation.Opacity}"
              RenderTransformOrigin="0,0"
              Source="{Binding FoodImage}"
            >
              <Image.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <SkewTransform />
                  <RotateTransform Angle="{Binding CurrentFoodLocation.Rotate}" />
                  <TranslateTransform />
                </TransformGroup>
              </Image.RenderTransform>
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Width">
                    <Setter.Value>
                      <MultiBinding
                        Converter="{StaticResource DoubleCalculatorConverter}"
                        ConverterParameter="*"
                      >
                        <Binding Path="CurrentFoodLocation.RectangleLocation.Width" />
                        <Binding Path="LengthRatio" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="Margin">
                    <Setter.Value>
                      <MultiBinding Converter="{StaticResource RatioMarginConverter}">
                        <Binding Path="LengthRatio" />
                        <Binding Path="CurrentFoodLocation.RectangleLocation.X" />
                        <Binding Path="CurrentFoodLocation.RectangleLocation.Y" />
                      </MultiBinding>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Image.Style>
            </Image>
            <Image
              x:Name="FrontImage"
              Height="250"
              Width="250"
              MaxHeight="250"
              MaxWidth="250"
              Source="{Binding CurrentFrontImage.Image}"
            />
          </Grid>
        </Border>
        <StackPanel Grid.Row="1">
          <Grid Margin="0,5,0,5" Grid.Row="1" ColumnDefinitions="*,*,*">
            <Button
              Width="100"
              Command="{Binding StopCommand}"
              Content="{ll:Str 停止}"
              Style="{StaticResource ModMaker_ButtonBaseStyle}"
            />
            <Button
              Grid.Column="1"
              Width="100"
              Command="{Binding StartCommand}"
              Content="{ll:Str 播放}"
              Style="{StaticResource ModMaker_ButtonBaseStyle}"
            />
            <ToggleButton
              Grid.Column="2"
              Width="100"
              Content="{ll:Str 循环}"
              IsChecked="{Binding Loop}"
              Style="{StaticResource StandardToggleButtonStyle}"
            />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <!--<Label Content="{ll:Str 动画ID}" />
            <TextBox Grid.Column="1" />-->
            <!--<Label Content="{ll:Str 动画类型}" Style="{StaticResource ModMaker_ThemedLabelStyle}" />
            <TextBlock
              Grid.Column="1"
              Padding="5"
              d:Text="Type"
              FontSize="14"
              Style="{StaticResource ModMaker_TextBlockLeftCenter}"
              Text="{Binding Anime.GraphType}"
            />-->
            <Label
              Grid.Row="1"
              Content="{ll:Str 动画名称}"
              Style="{StaticResource ModMaker_ThemedLabelStyle}"
            />
            <TextBox
              Grid.Row="1"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 动画名称}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding Anime.Name, UpdateSourceTrigger=PropertyChanged}"
            />
          </Grid>
        </StackPanel>
      </Grid>
      <Border
        Margin="0,5,0,5"
        Grid.Row="1"
        Height="2"
        CornerRadius="2"
        Background="{DynamicResource SecondaryLight}"
        Opacity="0.3"
      />
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <ListBox
          x:Name="ModeTypes"
          SelectedIndex="0"
          SelectionChanged="ModeTypes_SelectionChanged"
          PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
          Style="{DynamicResource SideMenuListBoxStyle}"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Tag="{Binding Anime.HappyAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModType_Happy'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.HappyAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.NomalAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_Nomal'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.NomalAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.PoorConditionAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_PoorCondition'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.PoorConditionAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
          <ListBoxItem Tag="{Binding Anime.IllAnimes}">
            <ListBoxItem.Content>
              <TextBlock>
                <Run Text="{ll:Str 'ModeType_Ill'}" />
                <Run Text="(" />
                <Run Text="{Binding Anime.IllAnimes.Count, Mode=OneWay}" />
                <Run Text=")" />
              </TextBlock>
            </ListBoxItem.Content>
          </ListBoxItem>
        </ListBox>
        <ListBox
          Grid.Row="1"
          x:Name="Animes"
          d:ItemsSource="{d:SampleData ItemCount=5}"
          d:SelectedIndex="0"
          Style="{DynamicResource SideMenuListBoxStyle}"
          ItemContainerStyle="{StaticResource Anime_ListBoxItemStyle}"
          ItemsSource="{Binding SelectedItem.Tag, ElementName=ModeTypes}"
          SelectedItem="{Binding CurrentAnimeModel}"
        />
        <Button
          Grid.Row="1"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Command="{Binding AddAnimeCommand}"
          CommandParameter="{Binding CurrentMode}"
          Content="➕"
          Style="{DynamicResource ModMaker_AddButton}"
        />
      </Grid>
    </Grid>
    <Border
      Margin="5,0,5,0"
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <Grid
      IsHitTestVisible="{Binding Playing, Converter={StaticResource BoolInverter}}"
      IsEnabled="{Binding CurrentAnimeModel,Converter={StaticResource NullToFalseConverter}}"
      Grid.Column="2"
      RowDefinitions="Auto,*"
    >
      <Grid Margin="0,0,0,5" ColumnDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,Auto">
          <TextBox
            Grid.Column="0"
            Width="200"
            VerticalAlignment="Center"
            pu:TextBoxHelper.Watermark="{ll:Str 动画ID(非必要)}"
            FontSize="14"
            Style="{StaticResource StandardTextBoxStyle}"
            Text="{Binding CurrentAnimeModel.ID, UpdateSourceTrigger=PropertyChanged}"
          />
          <!--<ComboBox
            Grid.Column="1"
            Width="200"
            Margin="10,0,0,0"
            ItemsSource="{Binding Source={x:Static m:AnimeTypeModel.AnimatTypes}, Converter={StaticResource EnumsToEnumInfosConverter}}"
            SelectedItem="{Binding CurrentAnimeModel.AnimeType, Converter={StaticResource EnumToEnumInfoConverter}}"
            Style="{StaticResource StandardComboBoxStyle}"
            Visibility="{Binding DataContext.HasMultiType, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}, Converter={StaticResource FalseToCollapsedConverter}}"
          />-->
        </Grid>
        <Grid Grid.Column="1" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto">
          <Button
            x:Name="AddImage"
            Grid.Column="0"
            Width="100"
            Margin="5,0,5,0"
            Style="{DynamicResource ModMaker_ButtonBaseStyle}"
            CommandParameter="{Binding CurrentAnimeModel}"
            Content="{ll:Str 添加}"
            Click="ButtonShowContextMenu_Click"
          >
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{ll:Str 添加前图像}" Command="{Binding AddFrontImageCommand}" />
                <MenuItem Header="{ll:Str 添加后图像}" Command="{Binding AddBackImageCommand}" />
                <MenuItem
                  Header="{ll:Str 添加食物位置}"
                  Command="{Binding AddeFoodLocationCommand}"
                />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button
            x:Name="ClearImage"
            Grid.Column="1"
            Width="100"
            Margin="5,0,5,0"
            Style="{DynamicResource ModMaker_ButtonBaseStyle}"
            CommandParameter="{Binding CurrentAnimeModel}"
            Content="{ll:Str 清空}"
            Click="ButtonShowContextMenu_Click"
          >
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{ll:Str 清空前图像}" Command="{Binding ClearFrontImageCommand}" />
                <MenuItem Header="{ll:Str 清空后图像}" Command="{Binding ClearBackImageCommand}" />
                <MenuItem
                  Header="{ll:Str 清空食物位置}"
                  Command="{Binding ClearFoodLocationCommand}"
                />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Grid>
      <StackPanel x:Name="AnimeImages" Grid.Row="1">
        <ListBox
          Height="190"
          x:Name="FrontImages"
          Grid.Row="1"
          d:ItemsSource="{d:SampleData ItemCount=5}"
          AllowDrop="True"
          Drop="ListBox_Images_Drop"
          ItemsSource="{Binding CurrentAnimeModel.FrontImages}"
          PreviewMouseMove="ListBox_Images_PreviewMouseMove"
          PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
          SelectedItem="{Binding CurrentFrontImage}"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          pu:ScrollBarHelper.ThumbBackground="{DynamicResource SecondaryLight}"
          pu:ScrollViewerHelper.ScrollBarPosition="Inside"
          pu:ScrollViewerHelper.ScrollBarThickness="5"
          pu:ListBoxHelper.CornerRadius="4"
          d:SelectedIndex="0"
          BorderThickness="1.5"
          pu:ListBoxHelper.ItemsSelectedBackground="{DynamicResource  PrimaryLighter}"
          BorderBrush="{DynamicResource DARKPrimary}"
          pu:ListBoxHelper.ItemsMargin="5,0,0,0"
          pu:ListBoxHelper.ItemsPadding="0"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                Width="150"
                Background="Transparent"
                RowDefinitions="Auto,*"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
              >
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem
                      d:Header="修改图片"
                      Command="{Binding PlacementTarget.Tag.ChangeFrontImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                      CommandParameter="{Binding}"
                      Header="{ll:Str 修改图片}"
                    />
                    <MenuItem
                      d:Header="删除图片"
                      Command="{Binding PlacementTarget.Tag.RemoveFrontImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                      CommandParameter="{Binding}"
                      Header="{ll:Str 删除图片}"
                    />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Image Width="150" Height="150" Source="{Binding Image}">
                  <Image.ToolTip>
                    <Image Width="250" Height="250" Source="{Binding Image}" />
                  </Image.ToolTip>
                </Image>
                <Grid Height="30" Grid.Row="1" ColumnDefinitions="Auto,*">
                  <Label
                    FontSize="12"
                    Padding="5,0,5,0"
                    VerticalContentAlignment="Center"
                    Style="{DynamicResource ModMaker_LabelCenterStyle}"
                    Content="{ll:Str 持续时间}"
                  />
                  <pu:NumberInput
                    Grid.Column="1"
                    Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    IsSnapToIntervalEnabled="False"
                    Value="{Binding Duration}"
                  />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox
          x:Name="BackImages"
          Height="190"
          Grid.Row="1"
          d:ItemsSource="{d:SampleData ItemCount=5}"
          AllowDrop="True"
          Drop="ListBox_Images_Drop"
          ItemsSource="{Binding CurrentAnimeModel.BackImages}"
          PreviewMouseMove="ListBox_Images_PreviewMouseMove"
          PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
          SelectedItem="{Binding CurrentBackImage}"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          pu:ScrollBarHelper.ThumbBackground="{DynamicResource SecondaryLight}"
          pu:ScrollViewerHelper.ScrollBarPosition="Inside"
          pu:ScrollViewerHelper.ScrollBarThickness="5"
          pu:ListBoxHelper.CornerRadius="4"
          d:SelectedIndex="0"
          BorderThickness="1.5"
          pu:ListBoxHelper.ItemsSelectedBackground="{DynamicResource  PrimaryLighter}"
          BorderBrush="{DynamicResource DARKPrimary}"
          pu:ListBoxHelper.ItemsMargin="5,0,0,0"
          pu:ListBoxHelper.ItemsPadding="0"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                Width="150"
                Background="Transparent"
                RowDefinitions="Auto,*"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
              >
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem
                      d:Header="修改图片"
                      Command="{Binding PlacementTarget.Tag.ChangeBackImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                      CommandParameter="{Binding}"
                      Header="{ll:Str 修改图片}"
                    />
                    <MenuItem
                      d:Header="删除图片"
                      Command="{Binding PlacementTarget.Tag.RemoveBackImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                      CommandParameter="{Binding}"
                      Header="{ll:Str 删除图片}"
                    />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Image Width="150" Height="150" Source="{Binding Image}">
                  <Image.ToolTip>
                    <Image Width="250" Height="250" Source="{Binding Image}" />
                  </Image.ToolTip>
                </Image>
                <Grid Height="30" Grid.Row="1" ColumnDefinitions="Auto,*">
                  <Label
                    FontSize="12"
                    Padding="5,0,5,0"
                    VerticalContentAlignment="Center"
                    Style="{DynamicResource ModMaker_LabelCenterStyle}"
                    Content="{ll:Str 持续时间}"
                  />
                  <pu:NumberInput
                    Grid.Column="1"
                    Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    IsSnapToIntervalEnabled="False"
                    Value="{Binding Duration}"
                  />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox
          x:Name="FoodLocations"
          Height="180"
          Grid.Row="1"
          d:ItemsSource="{d:SampleData ItemCount=5}"
          AllowDrop="True"
          Drop="ListBox_Images_Drop"
          ItemsSource="{Binding CurrentAnimeModel.FoodLocations}"
          PreviewMouseMove="ListBox_Images_PreviewMouseMove"
          PreviewMouseWheel="ListBox_HorizontalScrolling_PreviewMouseWheel"
          SelectedItem="{Binding CurrentFoodLocation}"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          pu:ScrollBarHelper.ThumbBackground="{DynamicResource SecondaryLight}"
          pu:ScrollViewerHelper.ScrollBarPosition="Inside"
          pu:ScrollViewerHelper.ScrollBarThickness="5"
          pu:ListBoxHelper.CornerRadius="4"
          d:SelectedIndex="0"
          BorderThickness="1.5"
          pu:ListBoxHelper.ItemsSelectedBackground="{DynamicResource  PrimaryLighter}"
          BorderBrush="{DynamicResource DARKPrimary}"
          pu:ListBoxHelper.ItemsMargin="5,0,0,0"
          pu:ListBoxHelper.ItemsPadding="0"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                Background="Transparent"
                Width="150"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
              >
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem
                      d:Header="删除食物定位"
                      Command="{Binding PlacementTarget.Tag.RemoveFoodLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                      CommandParameter="{Binding}"
                      Header="{ll:Str 删除食物定位}"
                      IsEnabled="{Binding PlacementTarget.Tag.PlayCommand.CurrentCanExecute, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                  Text="{ll:Str 持续时间}"
                />
                <pu:NumberInput
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  Height="25"
                  Grid.Column="1"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding Duration}"
                />
                <TextBlock
                  Grid.Row="1"
                  d:Text="旋转角度"
                  Text="{ll:Str 旋转角度}"
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                />
                <pu:NumberInput
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  Height="25"
                  Grid.Row="1"
                  Grid.Column="1"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding Rotate}"
                />
                <TextBlock
                  Grid.Row="2"
                  d:Text="透明度"
                  Text="{ll:Str 透明度}"
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                />
                <pu:NumberInput
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  Height="25"
                  Grid.Row="2"
                  Grid.Column="1"
                  Interval="0.1"
                  IsSnapToIntervalEnabled="False"
                  Maximum="1"
                  Minimum="0"
                  Value="{Binding Opacity}"
                />
                <TextBlock
                  Grid.Row="3"
                  d:Text="长度"
                  Text="{ll:Str 长度}"
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                />
                <pu:NumberInput
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  Height="25"
                  Grid.Row="3"
                  Grid.Column="1"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding RectangleLocation.Width}"
                />
                <TextBlock
                  Grid.Row="4"
                  Text="X:"
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                />
                <pu:NumberInput
                  Height="25"
                  Grid.Row="4"
                  Grid.Column="1"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding RectangleLocation.X}"
                />
                <TextBlock
                  Grid.Row="5"
                  Text="Y:"
                  Margin="5,0,5,0"
                  Style="{DynamicResource  ModMaker_TextBlockLeftCenter}"
                />
                <pu:NumberInput
                  Grid.Row="5"
                  Height="25"
                  Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                  Grid.Column="1"
                  IsSnapToIntervalEnabled="False"
                  Value="{Binding RectangleLocation.Y}"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>
  </Grid>
</pu:WindowX>
