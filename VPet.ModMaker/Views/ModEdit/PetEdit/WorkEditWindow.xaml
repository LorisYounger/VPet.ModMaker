<pu:WindowX
  x:Class="VPet.ModMaker.Views.WorkEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:m="clr-namespace:VPet.ModMaker.Models"
  Title="{ll:Str 编辑工作}"
  Width="1280"
  Height="720"
  MinWidth="800"
  MinHeight="600"
  d:DataContext="{d:DesignInstance Type=vm:WorkEditViewModel}"
  d:Height="1000"
  d:Width="800"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource WindowXStyle}"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid RowDefinitions="Auto,*,Auto">
      <Expander Style="{DynamicResource ModMaker_ExpanderBaseStyle}" Header="{ll:Str 测试图片}">
        <Border Style="{DynamicResource ModMaker_BorderItem}">
          <Grid Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Center">
            <Border
              BorderBrush="{DynamicResource DARKPrimaryLight}"
              BorderThickness="1.5"
              CornerRadius="4"
              HorizontalAlignment="Center"
              Background="Transparent"
            >
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding ChangeImageCommand}" Header="{ll:Str 修改测试图片}" />
                </ContextMenu>
              </Border.ContextMenu>
              <Grid Margin="2">
                <Image Width="250" Height="250" Source="{Binding Image}" Stretch="Uniform" />
                <Label
                  Padding="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  pu:LabelHelper.CornerRadius="4"
                  Background="{Binding Work.Background}"
                  BorderBrush="{Binding Work.BorderBrush}"
                  BorderThickness="3"
                >
                  <Label.Style>
                    <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                      <Setter Property="Width">
                        <Setter.Value>
                          <MultiBinding
                            Converter="{StaticResource DoubleCalculatorConverter}"
                            ConverterParameter="*"
                          >
                            <Binding Path="Work.Width" />
                            <Binding Path="LengthRatio" />
                          </MultiBinding>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="Height">
                        <Setter.Value>
                          <MultiBinding
                            Converter="{StaticResource DoubleCalculatorConverter}"
                            ConverterParameter="*/*"
                          >
                            <Binding Path="Work.Width" />
                            <Binding Path="LengthRatio" />
                            <Binding Source="300" />
                            <Binding Source="180" />
                          </MultiBinding>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="Margin">
                        <Setter.Value>
                          <MultiBinding Converter="{StaticResource RatioMarginConverter}">
                            <Binding Path="LengthRatio" />
                            <Binding Path="Work.Left" />
                            <Binding Path="Work.Top" />
                          </MultiBinding>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Label.Style>
                  <Label.Content>
                    <Grid>
                      <Label
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{Binding Work.Background}"
                        Content="{ll:Str 工作中}"
                        Foreground="{Binding Work.Foreground}"
                      />
                      <Button
                        VerticalAlignment="Bottom"
                        Background="{Binding Work.ButtonBackground}"
                        Content="{ll:Str 停止工作}"
                        Foreground="{Binding Work.ButtonForeground}"
                      />
                    </Grid>
                  </Label.Content>
                </Label>
                <Button
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Command="{Binding ChangeImageCommand}"
                  Content="{ll:Str 添加测试图片}"
                  Style="{DynamicResource ModMaker_ButtonBaseStyle}"
                  Visibility="{Binding Image, Converter={StaticResource NullToVisibleConverter}}"
                />
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Expander>
      <ScrollViewer Grid.Row="1" Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="ID" />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Work.ID}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 名称}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Work.Name}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 类型}"
              />
              <ComboBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                ItemsSource="{x:Static m:WorkModel.WorkTypes}"
                SelectedItem="{Binding Work.Type}"
                Style="{DynamicResource StandardComboBoxStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 指定动画}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Work.Graph, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 是否超模}"
              />
              <Grid
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                ColumnDefinitions="*,Auto"
              >
                <TextBlock
                  Padding="5"
                  d:Text="True"
                  FontSize="14"
                  Style="{StaticResource ModMaker_TextBlockLeftCenter}"
                  Text="{Binding Work.IsOverLoad}"
                />
                <Button
                  Grid.Column="1"
                  Command="{Binding FixOverLoadCommand}"
                  Content="{ll:Str 修复超模}"
                  Style="{StaticResource ModMaker_ButtonBaseStyle}"
                />
              </Grid>
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 基础倍率}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.MoneyBase}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 饱食度消耗倍率}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.StrengthFood}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 口渴度消耗倍率}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.StrengthDrink}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 心情消耗倍率}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.Feeling}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 完成奖励倍率}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.FinishBonus}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 等级限制}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.LevelLimit}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 花费时间(分钟)}"
              />
              <pu:NumberInput
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Work.Time}"
              />
            </Grid>
          </Border>
          <GroupBox
            Margin="0,5,0,0"
            Header="{ll:Str 按钮样式}"
            Style="{DynamicResource ModMaker_GroupBoxBaseStyle}"
          >
            <StackPanel>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 边框颜色}"
                  />
                  <pu:ColorPicker
                    Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    ColorChannels="RGB"
                    SelectedColor="{Binding Work.BorderBrush, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 背景颜色}"
                  />
                  <pu:ColorPicker
                    Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    ColorChannels="RGB"
                    SelectedColor="{Binding Work.Background, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 字体颜色}"
                  />
                  <pu:ColorPicker
                    Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    ColorChannels="RGB"
                    SelectedColor="{Binding Work.Foreground, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 按钮背景颜色}"
                  />
                  <pu:ColorPicker
                    Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    ColorChannels="RGB"
                    SelectedColor="{Binding Work.ButtonBackground, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 按钮字体颜色}"
                  />
                  <pu:ColorPicker
                    Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    ColorChannels="RGB"
                    SelectedColor="{Binding Work.ButtonForeground, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="X" />
                  <pu:NumberInput
                    Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    IsSnapToIntervalEnabled="False"
                    Value="{Binding Work.Left}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="Y" />
                  <pu:NumberInput
                    Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    IsSnapToIntervalEnabled="False"
                    Value="{Binding Work.Top}"
                  />
                </Grid>
              </Border>
              <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock
                    Style="{DynamicResource ModMaker_TextBlockItemName}"
                    Text="{ll:Str 宽}"
                  />
                  <pu:NumberInput
                    Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Right"
                    IsSnapToIntervalEnabled="False"
                    Value="{Binding Work.Width}"
                  />
                </Grid>
              </Border>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border
      Margin="5,0,5,0"
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <ListBox Grid.Column="2" Template="{StaticResource ModMaker_CultureList}" />
  </Grid>
</pu:WindowX>
