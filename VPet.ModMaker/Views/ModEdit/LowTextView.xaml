<UserControl
  x:Class="VPet.ModMaker.Views.LowTextView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:LowTextEditViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <TextBox
        pu:TextBoxHelper.Watermark="{ll:Str 搜索}"
        Style="{StaticResource StandardTextBoxStyle}"
        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
      />
      <ComboBox
        Grid.Column="1"
        ItemsSource="{x:Static vm:LowTextEditViewModel.SearchTargets}"
        SelectedItem="{Binding CurrentSearchTarget}"
        Style="{StaticResource StandardComboBoxStyle}"
        ToolTip="{ll:Str 搜索目标}"
      />
    </Grid>
    <DataGrid
      Grid.Row="1"
      d:ItemsSource="{d:SampleData ItemCount=5}"
      d:SelectedIndex="0"
      ItemsSource="{Binding LowTexts.FilteredList}"
      MouseDoubleClick="DataGrid_MouseDoubleClick"
      FrozenColumnCount="1"
      Style="{DynamicResource ModMaker_ModelsDataGrid}"
    >
      <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
          <Setter Property="Height" Value="64" />
          <Setter Property="Tag" Value="{Binding}" />
          <Setter
            Property="ContextMenu"
            Value="{StaticResource DataGridRow_EditAndRemovesContextMenu}"
          />
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn
          MaxWidth="200"
          Binding="{Binding ID}"
          CanUserSort="True"
          ElementStyle="{StaticResource TextBlock_Wrap}"
          Header="ID"
          IsReadOnly="True"
          SortMemberPath="ID"
        />
        <DataGridTextColumn
          MaxWidth="300"
          Binding="{Binding Text}"
          CanUserSort="True"
          ElementStyle="{StaticResource TextBlock_Wrap}"
          Header="{ll:Str 文本}"
          IsReadOnly="True"
          SortMemberPath="Text"
        />
        <DataGridTextColumn
          Binding="{Binding Mode, Converter={StaticResource EnumToEnumInfoConverter}}"
          CanUserSort="True"
          ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
          Header="{ll:Str 状态}"
          IsReadOnly="True"
          SortMemberPath="Mode"
        />
        <DataGridTextColumn
          Binding="{Binding Strength, Converter={StaticResource EnumToEnumInfoConverter}}"
          CanUserSort="True"
          ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
          Header="{ll:Str 饥渴需求}"
          IsReadOnly="True"
          SortMemberPath="Strength"
        />
        <DataGridTextColumn
          Binding="{Binding Like, Converter={StaticResource EnumToEnumInfoConverter}}"
          CanUserSort="True"
          ElementStyle="{StaticResource ModMaker_TextBlockLeftCenter}"
          Header="{ll:Str 好感需求}"
          IsReadOnly="True"
          SortMemberPath="Like"
        />
      </DataGrid.Columns>
    </DataGrid>
    <Button
      Grid.Row="1"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Command="{Binding AddCommand}"
      Content="➕"
      Style="{DynamicResource ModMaker_AddButton}"
    />
  </Grid>
</UserControl>
