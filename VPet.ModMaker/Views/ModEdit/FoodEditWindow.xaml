<pu:WindowX
  x:Class="VPet.ModMaker.Views.FoodEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  Title="{ll:Str 编辑食物}"
  Width="1280"
  Height="720"
  d:DataContext="{d:DesignInstance Type=vm:FoodEditViewModel}"
  d:Height="1000"
  d:Width="800"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource WindowXStyle}"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="200" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="40,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物图片}"
              />
              <Grid Grid.RowSpan="2" Grid.Column="1" Width="300" HorizontalAlignment="Right">
                <Border
                  Height="190"
                  Width="190"
                  BorderBrush="{DynamicResource DARKPrimaryLight}"
                  BorderThickness="1.5"
                  CornerRadius="4"
                  HorizontalAlignment="Center"
                  Background="Transparent"
                >
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Command="{Binding ChangeImageCommand}" Header="{ll:Str 修改图片}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid>
                    <Image
                      x:Name="Image_FoodImage"
                      Width="180"
                      Height="180"
                      Source="{Binding Food.Image}"
                      Stretch="Uniform"
                    />
                    <Button
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Command="{Binding AddImageCommand}"
                      Content="{ll:Str 添加图片}"
                      Visibility="{Binding Food.Image, Converter={StaticResource NullToVisibleConverter}}"
                      Style="{StaticResource ModMaker_ButtonBaseStyle}"
                      Tag="{Binding Food.Image}"
                    />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="ID" />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="ID"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Food.ID, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物名称}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="{ll:Str 食物名称}"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Food.Name, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="120" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid RowDefinitions="40,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物描述}"
              />
              <TextBox
                Grid.Row="1"
                Margin="0,0,0,5"
                pu:TextBoxHelper.Watermark="{ll:Str 食物描述}"
                Style="{DynamicResource StandardTextBoxWrapStyle}"
                Text="{Binding Food.Description, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物类型}"
              />
              <ComboBox
                x:Name="ComboBox_FoodType"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                ItemsSource="{Binding Food.FoodTypes, Converter={StaticResource EnumsToEnumInfosConverter}}"
                SelectedItem="{Binding Food.Type, Converter={StaticResource EnumToEnumInfoConverter}}"
                Style="{DynamicResource StandardComboBoxStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 动画名称}"
              />
              <TextBox
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                pu:TextBoxHelper.Watermark="{ll:Str 绑定的动画名称(非必要)}"
                Style="{DynamicResource StandardTextBoxStyle}"
                Text="{Binding Food.Graph, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 饱腹值}"
              />
              <pu:NumberInput
                x:Name="NumberInput_StrengthFood"
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.StrengthFood, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 口渴值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.StrengthDrink, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 健康值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Health, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 体力值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Strength, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 心情值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Feeling, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 好感值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Likability, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 经验值}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Exp, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 价格}"
              />
              <pu:NumberInput
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                IsSnapToIntervalEnabled="False"
                Value="{Binding Food.Price, Mode=TwoWay}"
                Style="{DynamicResource ModMaker_NumberInputBaseStyle}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 参考价格}"
              />
              <Grid
                Grid.Column="1"
                Width="300"
                HorizontalAlignment="Right"
                ColumnDefinitions="*,Auto"
              >
                <TextBlock
                  Padding="5"
                  d:Text="111"
                  Style="{StaticResource ModMaker_TextBlockLeftCenter}"
                  Text="{Binding Food.ReferencePrice}"
                />
                <Button
                  Grid.Column="1"
                  Command="{Binding SetReferencePriceCommand}"
                  CommandParameter="{Binding Food}"
                  Width="100"
                  Content="{ll:Str 设置}"
                  Style="{StaticResource ModMaker_ButtonBaseStyle}"
                />
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" ColumnDefinitions="*,*">
        <Button
          x:Name="Button_Yes"
          Width="200"
          Margin="10"
          Click="Button_Yes_Click"
          Content="{ll:Str 确定}"
          Style="{StaticResource MyThemedButtonStyle}"
        />
        <Button
          x:Name="Button_Cancel"
          Grid.Column="1"
          Width="200"
          Margin="10"
          Click="Button_Cancel_Click"
          Content="{ll:Str 取消}"
          Style="{StaticResource Button_Cancel}"
        />
      </Grid>
    </Grid>
    <Border
      Grid.Column="1"
      Width="2"
      Margin="5,0,5,0"
      Background="{DynamicResource SecondaryLight}"
      CornerRadius="2"
      Opacity="0.3"
    />
    <Grid Grid.Column="2" RowDefinitions="*,Auto">
      <ListBox Template="{StaticResource ModMaker_CultureList}" />
      <Grid Grid.Row="1" RowDefinitions="*,*">
        <Label
          Height="30"
          Content="{ll:Str 自动设置参考价格}"
          FontSize="16"
          FontWeight="Bold"
          VerticalContentAlignment="Center"
          Style="{StaticResource ModMaker_LabelBaseStyle}"
        />
        <pu:Switch
          Height="30"
          HorizontalAlignment="Center"
          Grid.Row="1"
          BoxHeight="18"
          BoxWidth="100"
          Margin="0"
          FontSize="14"
          Style="{DynamicResource ModMaker_SwitchSwitchOnly}"
          IsChecked="{Binding ModInfo.AutoSetFoodPrice}"
        />
      </Grid>
    </Grid>
  </Grid>
</pu:WindowX>
