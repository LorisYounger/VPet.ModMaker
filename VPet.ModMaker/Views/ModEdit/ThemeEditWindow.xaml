                ColorChannels="RGB"
                SelectedColor="{Binding Theme.SecondaryText, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimary}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimary, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimaryLight}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimaryLight, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimaryLighter}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimaryLighter, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimaryDark}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimaryDark, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimaryDarker}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimaryDarker, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str DARKPrimaryText}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.DARKPrimaryText, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str ShadowColor}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.ShadowColor, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" ColumnDefinitions="*,*">
        <Button
          x:Name="Button_Yes"
          Margin="10"
          Width="200"
          Click="Button_Yes_Click"
          Content="{ll:Str 确定}"
          Style="{StaticResource MyThemedButtonStyle}"
        />
        <Button
          x:Name="Button_Cancel"
          Grid.Column="1"
          Width="200"
          Margin="10"
          Click="Button_Cancel_Click"
          Content="{ll:Str 取消}"
          Style="{StaticResource Button_Cancel}"
        />
      </Grid>
    </Grid>
    <Border
      Margin="5,0,5,0"
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <ListBox Grid.Column="2" Template="{StaticResource ModMaker_CultureList}" />
  </Grid>
</pu:WindowX>
