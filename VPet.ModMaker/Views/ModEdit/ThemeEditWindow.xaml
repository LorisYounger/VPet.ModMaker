<pu:WindowX
  x:Class="VPet.ModMaker.Views.ThemeEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  mc:Ignorable="d"
  Title="ThemeEditWindow"
  d:DataContext="{d:DesignInstance vm:ThemeEditViewModel}"
  Width="1280"
  Height="720"
  WindowStartupLocation="CenterScreen"
>
  <Grid ColumnDefinitions="*,Auto,Auto">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Padding="10" Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="{ll:Str ID}" />
              <TextBox
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding Theme.ID}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str Name}"
              />
              <TextBox
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding Theme.Name}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str Primary}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.Primary, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str PrimaryLight}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.PrimaryLight, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str PrimaryLighter}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.PrimaryLighter, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str PrimaryDark}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.PrimaryDark, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str PrimaryDarker}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.PrimaryDarker, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str PrimaryText}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.PrimaryText, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str Secondary}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.Secondary, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str SecondaryLight}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.SecondaryLight, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str SecondaryLighter}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.SecondaryLighter, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str SecondaryDark}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.SecondaryDark, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str SecondaryDarker}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
                Width="300"
                HorizontalAlignment="Right"
                Grid.Column="1"
                Grid.Row="2"
                ColorChannels="RGB"
                SelectedColor="{Binding Theme.SecondaryDarker, Converter={StaticResource SolidColorBrushToMediaColorConverter}}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str SecondaryText}"
              />
              <pu:ColorPicker
                Style="{DynamicResource ModMaker_ColorPickerBaseStyle}"
