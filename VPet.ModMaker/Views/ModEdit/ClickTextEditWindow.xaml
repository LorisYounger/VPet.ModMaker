<pu:WindowX
  x:Class="VPet.ModMaker.Views.ClickTextEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  Title="{ll:Str 编辑点击文本}"
  Width="1280"
  Height="720"
  d:DataContext="{d:DesignInstance Type=vm:ClickTextEditViewModel}"
  d:Height="2000"
  d:Width="800"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource WindowXStyle}"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="ID" />
              <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                Width="300"
                pu:TextBoxHelper.Watermark="ID"
                Style="{StaticResource StandardTextBoxWrapStyle}"
                Text="{Binding ClickText.ID, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
              />
            </Grid>
          </Border>
          <Border Height="120" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid RowDefinitions="40,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 文本}"
              />
              <TextBox
                x:Name="TextBox_Text"
                Grid.Row="1"
                Margin="0,0,0,5"
                d:Text="这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,"
                pu:TextBoxHelper.Watermark="{ll:Str 文本}"
                Style="{StaticResource StandardTextBoxWrapStyle}"
                Text="{Binding ClickText.Text, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 指定工作}"
              />
              <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                Width="300"
                pu:TextBoxHelper.Watermark="{ll:Str 非必要}"
                Style="{StaticResource StandardTextBoxStyle}"
                Text="{Binding ClickText.Working, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 行动状态}"
              />
              <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                Width="300"
                ItemsSource="{Binding ClickText.WorkingStates, Converter={StaticResource EnumsToEnumInfosConverter}}"
                SelectedItem="{Binding ClickText.WorkingState, Converter={StaticResource EnumToEnumInfoConverter}}"
                Style="{StaticResource StandardComboBoxStyle}"
              />
            </Grid>
          </Border>
          <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 宠物状态}"
              />
              <Control
                Grid.Column="1"
                Grid.RowSpan="2"
                DataContext="{Binding ClickText.Mode}"
                Tag="{Binding DataContext.ClickText.ModeTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                Template="{StaticResource ModMaker_FlagableEnumControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 日期区间}"
              />
              <Control
                Grid.Column="1"
                Grid.RowSpan="2"
                DataContext="{Binding ClickText.DayTime}"
                Tag="{Binding DataContext.ClickText.DayTimes, RelativeSource={RelativeSource AncestorType=Window}}"
                Template="{StaticResource ModMaker_FlagableEnumControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 好感度范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Like}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 健康度范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Health}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 等级范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Level}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 金钱范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Money}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Food}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 口渴范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Drink}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 心情范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Feel}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 体力范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding ClickText.Strength}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="1" ColumnDefinitions="*,*">
        <Button
          x:Name="Button_Yes"
          Margin="10"
          Width="200"
          Click="Button_Yes_Click"
          Content="{ll:Str 确定}"
          Style="{StaticResource MyThemedButtonStyle}"
        />
        <Button
          x:Name="Button_Cancel"
          Grid.Column="1"
          Width="200"
          Margin="10"
          Click="Button_Cancel_Click"
          Content="{ll:Str 取消}"
          Style="{StaticResource Button_Cancel}"
        />
      </Grid>
    </Grid>
    <Border
      Margin="5,0,5,0"
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <ListBox Grid.Column="2" Template="{StaticResource ModMaker_CultureList}" />
  </Grid>
</pu:WindowX>
