<pu:WindowX
  x:Class="VPet.ModMaker.Views.SelectTextEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:m="clr-namespace:VPet.ModMaker.Models"
  Title="{ll:Str 编辑选择文本}"
  Width="1280"
  Height="720"
  MinWidth="800"
  MinHeight="600"
  d:DataContext="{d:DesignInstance Type=vm:SelectTextEditViewModel}"
  d:Height="1000"
  d:Width="800"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource BaseWindowXStyle}"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer Style="{DynamicResource ModMaker_ScrollViewerBaseStyle}">
        <StackPanel>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Style="{DynamicResource ModMaker_TextBlockItemName}" Text="{ll:Str ID}" />
              <TextBox
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding SelectText.ID, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 选项名}"
              />
              <TextBox
                pu:TextBoxHelper.Watermark="{ll:Str 显示在选项列表中的名称}"
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding SelectText.Choose, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="120" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid RowDefinitions="40,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 文本}"
              />
              <TextBox
                Margin="0,0,0,5"
                Grid.Row="1"
                d:Text="这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,这是一个测试文本,"
                pu:TextBoxHelper.Watermark="{ll:Str 显示在选项列表中的名称}"
                Style="{DynamicResource ModMaker_TextBoxWrapStyle}"
                Grid.Column="1"
                Text="{Binding SelectText.Text, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 标签}"
              />
              <TextBox
                pu:TextBoxHelper.Watermark="{ll:Str 多标签使用逗号分隔}"
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding SelectText.Tags, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 跳转标签}"
              />
              <TextBox
                pu:TextBoxHelper.Watermark="{ll:Str 多标签使用逗号分隔}"
                Style="{DynamicResource StandardTextBoxStyle}"
                HorizontalAlignment="Right"
                Width="300"
                Grid.Column="1"
                Text="{Binding SelectText.ToTags, UpdateSourceTrigger=PropertyChanged}"
              />
            </Grid>
          </Border>
          <Border Height="80" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid RowDefinitions="*,*" ColumnDefinitions="Auto,*">
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 宠物状态}"
              />
              <Control
                Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Mode}"
                Tag="{x:Static m:SelectTextModel.ModeTypes}"
                Template="{DynamicResource ModMaker_FlagableEnumControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 好感度范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Like}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 健康度范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Health}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 等级范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Level}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 金钱范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Money}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 食物范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Food}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 口渴范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Drink}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 心情范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Feel}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
          <Border Height="40" Style="{DynamicResource ModMaker_BorderItem}">
            <Grid>
              <TextBlock
                Style="{DynamicResource ModMaker_TextBlockItemName}"
                Text="{ll:Str 体力范围}"
              />
              <Control
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                DataContext="{Binding SelectText.Strength}"
                Template="{DynamicResource ModMaker_ObservableRangeControlTemplate}"
              />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border
      Margin="5,0,5,0"
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <ListBox Grid.Column="2" Template="{StaticResource ModMaker_CultureList}" />
  </Grid>
</pu:WindowX>
