<UserControl
  x:Class="VPet.ModMaker.Views.ThemeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:ThemeEditViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
>
  <UserControl.Resources>
    <DataTemplate x:Key="ModMaker_BrushCell">
      <Grid Margin="5" RowDefinitions="*,*">
        <Rectangle
          Fill="{Binding}"
          Height="20"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
        />
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Grid.Row="1"
          Text="{Binding}"
        />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <TextBox
        pu:TextBoxHelper.Watermark="{ll:Str 搜索}"
        Style="{StaticResource StandardTextBoxStyle}"
        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
      />
      <ComboBox
        Grid.Column="1"
        ItemsSource="{x:Static vm:LowTextEditViewModel.SearchTargets}"
        SelectedItem="{Binding CurrentSearchTarget}"
        Style="{StaticResource StandardComboBoxStyle}"
        ToolTip="{ll:Str 搜索目标}"
      />
    </Grid>
    <DataGrid
      Grid.Row="1"
      d:ItemsSource="{d:SampleData ItemCount=5}"
      d:SelectedIndex="0"
      pu:DataGridHelper.ColumnHeaderHorizontalContentAlignment="Center"
      pu:DataGridHelper.RowSelectedBorderBrush="{StaticResource DARKPrimaryLight}"
      pu:DataGridHelper.RowSelectedBorderThickness="3"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      CanUserReorderColumns="False"
      CanUserResizeRows="False"
      GridLinesVisibility="Horizontal"
      ItemsSource="{Binding Themes.FilteredList}"
      MouseDoubleClick="DataGrid_MouseDoubleClick"
      RowDetailsVisibilityMode="Visible"
      RowHeight="64"
      VirtualizingStackPanel.IsVirtualizing="True"
      VirtualizingStackPanel.VirtualizationMode="Recycling"
    >
      <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
          <Setter Property="Height" Value="64" />
          <Setter Property="Tag" Value="{Binding}" />
          <Setter Property="ContextMenu" Value="{StaticResource ContextMenu_DataGridRow}" />
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn
          MaxWidth="200"
          Binding="{Binding ID}"
          CanUserSort="True"
          ElementStyle="{StaticResource TextBlock_LeftCenter}"
          Header="ID"
          IsReadOnly="True"
          SortMemberPath="ID"
        />
        <DataGridTextColumn
          MaxWidth="300"
          Binding="{Binding Name}"
          CanUserSort="True"
          ElementStyle="{StaticResource TextBlock_LeftCenter}"
          Header="{ll:Str 名称}"
          IsReadOnly="True"
          SortMemberPath="Text"
        />
        <DataGridTemplateColumn Header="{ll:Str Primary}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding Primary}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str PrimaryLight}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding PrimaryLight}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str PrimaryLighter}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding PrimaryLighter}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str PrimaryDark}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding PrimaryDark}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str PrimaryDarker}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding PrimaryDarker}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str PrimaryText}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding PrimaryText}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str Secondary}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding Secondary}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str SecondaryLight}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding SecondaryLight}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str SecondaryLighter}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding SecondaryLighter}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str SecondaryDark}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding SecondaryDark}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str SecondaryDarker}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding SecondaryDarker}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str SecondaryText}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding SecondaryText}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimary}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimary}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimaryLight}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimaryLight}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimaryLighter}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimaryLighter}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimaryDark}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimaryDark}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimaryDarker}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimaryDarker}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str DARKPrimaryText}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding DARKPrimaryText}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{ll:Str ShadowColor}" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ContentPresenter
                Content="{Binding ShadowColor}"
                ContentTemplate="{StaticResource ModMaker_BrushCell}"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Button
      Grid.Row="1"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Command="{Binding AddCommand}"
      Content="➕"
      Style="{StaticResource AddButton}"
    />
  </Grid>
</UserControl>
