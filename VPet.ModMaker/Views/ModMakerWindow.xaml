<pu:WindowX
  x:Class="VPet.ModMaker.Views.ModMakerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:h="https://hkw.com/wpf/helpers"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  Title="{ll:Str Mod制作器}"
  Width="{ll:Dbe ModMakerWindowW_1000,DefValue=1000}"
  Height="{ll:Dbe ModMakerWindowH_600,DefValue=600}"
  d:DataContext="{d:DesignInstance Type=vm:ModMakerViewModel}"
  d:Height="500"
  d:Width="800"
  AutomationProperties.AutomationId="ModMakerWindow"
  FontSize="16"
  Style="{DynamicResource WindowXStyle}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition MinWidth="500" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" MinWidth="200" />
    </Grid.ColumnDefinitions>
    <Grid Margin="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label
        Height="NaN"
        Padding="10"
        Background="Transparent"
        Content="{ll:Str 最近的内容}"
        FontSize="20"
        FontWeight="Bold"
        Style="{StaticResource ModMaker_LabelBaseStyle}"
      />
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          Margin="5,5,0,5"
          pu:TextBoxHelper.Watermark="{ll:Str 搜索}"
          Style="{StaticResource StandardTextBoxStyle}"
          Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
        />
        <Button
          x:Name="Button_ClearHistory"
          Grid.Column="1"
          Margin="5"
          AutomationProperties.AutomationId="Button_ClearHistory"
          Command="{Binding ClearHistoryCommand}"
          Content="{ll:Str 清空历史}"
          MinWidth="100"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
      </Grid>
      <ListBox
        Margin="5"
        Grid.Row="2"
        HorizontalContentAlignment="Stretch"
        d:ItemsSource="{d:SampleData ItemCount=5}"
        pu:ListBoxHelper.ItemsHeight="64"
        pu:ListBoxHelper.ItemsMargin="5"
        pu:ListBoxHelper.ItemsPadding="5"
        pu:ListBoxHelper.ItemsBackground="#06000000"
        pu:ListBoxHelper.ItemsHoverBackground="{DynamicResource SecondaryLight}"
        pu:ListBoxHelper.ItemsBorderThickness="2"
        ItemsSource="{Binding Histories.FilteredList}"
        pu:ScrollBarHelper.ThumbBackground="{DynamicResource SecondaryLight}"
        pu:ScrollViewerHelper.ScrollBarThickness="5"
        pu:ScrollViewerHelper.ScrollBarPosition="Inside"
        Style="{DynamicResource SideMenuListBoxStyle}"
      >
        <ListBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid
              Background="Transparent"
              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
              ToolTip="{Binding SourcePath}"
            >
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem
                    Command="{Binding PlacementTarget.Tag.OpenModPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    Header="{ll:Str 打开所在的文件夹}"
                  />
                  <MenuItem
                    Command="{Binding PlacementTarget.Tag.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu, Mode=FindAncestor}}"
                    Header="{ll:Str 删除历史}"
                  />
                </ContextMenu>
              </Grid.ContextMenu>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Image Width="64" Margin="0,0,5,0" Source="{Binding Image}">
                <Image.ToolTip>
                  <Image Width="256" Height="256" Source="{Binding Image}" />
                </Image.ToolTip>
              </Image>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                  MaxWidth="200"
                  HorizontalAlignment="Left"
                  d:Text="{ll:Str Mod名称}"
                  FontWeight="Bold"
                  Text="{Binding ID}"
                  ToolTip="{Binding ID}"
                />
                <TextBlock
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Text="{Binding LastTime, StringFormat='G', ConverterCulture={h:CultureInfo}}"
                />
                <TextBlock
                  Grid.Row="1"
                  VerticalAlignment="Bottom"
                  d:Text="{ll:Str 路径}"
                  Text="{Binding SourcePath}"
                />
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border
      Grid.Column="1"
      Width="2"
      CornerRadius="2"
      Background="{DynamicResource SecondaryLight}"
      Opacity="0.3"
    />
    <Grid Margin="5" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label
        Height="NaN"
        Padding="10"
        Background="Transparent"
        Content="{ll:Str 开始使用}"
        FontSize="20"
        FontWeight="Bold"
        MouseDoubleClick="Label_MouseDoubleClick"
        Style="{StaticResource ModMaker_LabelBaseStyle}"
      />
      <StackPanel Grid.Row="1">
        <Button
          x:Name="Button_CreateNewMod"
          Margin="5"
          AutomationProperties.AutomationId="Button_CreateNewMod"
          Command="{Binding CreateNewModCommand}"
          Content="{ll:Str 创建新的模组}"
          Style="{DynamicResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          x:Name="Button_LoadFromPath"
          Margin="5"
          Command="{Binding LoadModFromPathCommand}"
          Content="{ll:Str 从文件夹中载入模组}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          x:Name="Button_OpenModMakerPath"
          Margin="5"
          Command="{Binding OpenModMakerPathCommand}"
          Content="{ll:Str 打开模组制作器目录}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
      </StackPanel>
      <StackPanel Grid.Row="2">
        <Label
          Height="40"
          Content="{ll:Str 最小日志级别}"
          FontSize="16"
          FontWeight="Bold"
          VerticalContentAlignment="Center"
          Style="{StaticResource ModMaker_LabelBaseStyle}"
        />
        <ComboBox
          Height="30"
          Margin="5"
          Style="{DynamicResource StandardComboBoxStyle}"
          ItemsSource="{x:Static vm:ModMakerViewModel.LogLevels}"
          SelectedItem="{Binding CurrentLogLevel}"
        />
        <Button
          x:Name="Button_OpenLogFile"
          Margin="5"
          Command="{Binding OpenLogFileCommand}"
          Content="{ll:Str 打开日志文件}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <TextBlock Grid.Row="3" Margin="5" HorizontalAlignment="Center">
          <Hyperlink Command="{Binding OpenWikiLinkCommand}">
            <TextBlock Text="{ll:Str 模组制作教程}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</pu:WindowX>
