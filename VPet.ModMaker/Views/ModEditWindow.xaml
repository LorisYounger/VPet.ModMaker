<pu:WindowX
  x:Class="VPet.ModMaker.Views.ModEditWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
  xmlns:local="clr-namespace:VPet.ModMaker.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pu="https://opensource.panuon.com/wpf-ui"
  xmlns:vm="clr-namespace:VPet.ModMaker.ViewModels"
  xmlns:v="clr-namespace:VPet.ModMaker.Views"
  xmlns:h="https://hkw.com/wpf/helpers"
  Title="{ll:Str 模组编辑器}"
  Width="{ll:Dbe ModEditWindowW_1280,DefValue=1280}"
  Height="{ll:Dbe ModEditWindowW_700,DefValue=700}"
  d:DataContext="{d:DesignInstance Type=vm:ModEditViewModel}"
  d:Height="500"
  d:Width="800"
  AutomationProperties.AutomationId="ModEditWindow"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Window.Resources>
    <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
  </Window.Resources>
  <Grid
    Margin="10"
    x:Name="LayoutRoot"
    MouseLeave="LayoutRoot_MouseLeave"
    MouseMove="LayoutRoot_MouseMove"
  >
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid x:Name="Grid_ModInfo" MaxWidth="256">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Border Background="#04000000" CornerRadius="2">
          <Image
            x:Name="Image_ModImage"
            Width="256"
            Height="256"
            Source="{Binding ModInfo.Image}"
            Stretch="Uniform"
          >
            <Image.ContextMenu>
              <ContextMenu>
                <MenuItem
                  x:Name="MenuItem_ChangeModImage"
                  Command="{Binding ChangeImageCommand}"
                  Header="{ll:Str 修改图片}"
                />
              </ContextMenu>
            </Image.ContextMenu>
          </Image>
        </Border>
        <Button
          x:Name="Button_AddModImage"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Command="{Binding ChangeImageCommand}"
          Content="{ll:Str 添加图片}"
        >
          <Button.Style>
            <Style BasedOn="{StaticResource ModMaker_ButtonBaseStyle}" TargetType="Button">
              <Setter Property="Visibility" Value="Hidden" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ModInfo.Image}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <ScrollViewer
          Grid.Row="1"
          Style="{StaticResource ModMaker_ScrollViewerBaseStyle}"
          VerticalScrollBarVisibility="Auto"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="ID" Style="{StaticResource ModMaker_LabelThemedStyle}" />
            <TextBox
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="ID"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.ID, UpdateSourceTrigger=PropertyChanged}"
            />
            <Label
              Grid.Row="1"
              Content="{ll:Str 作者}"
              Style="{StaticResource ModMaker_LabelThemedStyle}"
            />
            <TextBox
              x:Name="TextBox_Author"
              Grid.Row="1"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 作者}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.Author, UpdateSourceTrigger=PropertyChanged}"
            />
            <Label
              Grid.Row="2"
              Content="{ll:Str 游戏版本}"
              Style="{StaticResource ModMaker_LabelThemedStyle}"
            />
            <TextBox
              x:Name="TextBox_GameVersion"
              Grid.Row="2"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 游戏版本}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.GameVersion, UpdateSourceTrigger=PropertyChanged}"
            />
            <Label
              Grid.Row="3"
              Content="{ll:Str 模组版本}"
              Style="{StaticResource ModMaker_LabelThemedStyle}"
            />
            <TextBox
              x:Name="TextBox_ModVersion"
              Grid.Row="3"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 模组版本}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.ModVersion, UpdateSourceTrigger=PropertyChanged}"
            />
            <Label
              Grid.Row="4"
              Content="{ll:Str 模组名称}"
              Style="{StaticResource ModMaker_LabelThemedStyle}"
            />
            <TextBox
              Grid.Row="4"
              Grid.Column="1"
              pu:TextBoxHelper.Watermark="{ll:Str 模组名称}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.Name, UpdateSourceTrigger=PropertyChanged}"
            />
            <Label
              Grid.Row="5"
              Grid.ColumnSpan="2"
              Content="{ll:Str 模组介绍}"
              MouseDoubleClick="Label_MouseDoubleClick"
              Style="{StaticResource ModMaker_LabelThemedStyle}"
            />
            <TextBox
              x:Name="TextBox_Description"
              Grid.Row="6"
              Grid.ColumnSpan="2"
              Height="NaN"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Top"
              d:Text="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              pu:TextBoxHelper.Watermark="{ll:Str 模组介绍}"
              Style="{StaticResource StandardTextBoxStyle}"
              Text="{Binding ModInfo.Description, UpdateSourceTrigger=PropertyChanged}"
              TextWrapping="Wrap"
            />
          </Grid>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <ListBox
          x:Name="Views"
          ItemsSource="{Binding ViewModels}"
          SelectedIndex="0"
          pu:ListBoxHelper.ItemsCornerRadius="0"
          pu:ListBoxHelper.ItemsHoverBackground="{StaticResource SecondaryLight}"
          pu:ListBoxHelper.ItemsMargin="0"
          pu:ListBoxHelper.ItemsPadding="5"
          DisplayMemberPath="DisplayText"
          PreviewMouseWheel="ListBox_Pages_PreviewMouseWheel"
          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          Style="{StaticResource SideMenuListBoxStyle}"
          pu:ScrollBarHelper.Background="{DynamicResource SecondaryLight}"
          pu:ScrollViewerHelper.ScrollBarThickness="5"
          pu:ScrollViewerHelper.ScrollBarPosition="Inside"
        >
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Content" Value="{Binding Value}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <Grid
          Grid.Row="1"
          h:PanelHelper.ShowChildByIndex="{Binding SelectedIndex,ElementName=Views}"
        >
          <v:FoodView DataContext="{Binding ViewModels[Food]}" />
          <v:ClickTextView DataContext="{Binding ViewModels[ClickText]}" Visibility="Hidden" />
          <v:LowTextView DataContext="{Binding ViewModels[LowText]}" Visibility="Hidden" />
          <v:SelectTextView DataContext="{Binding ViewModels[SelectText]}" Visibility="Hidden" />
          <v:ThemeView DataContext="{Binding ViewModels[Theme]}" Visibility="Hidden" />
          <v:FontView DataContext="{Binding ViewModels[Font]}" Visibility="Hidden" />
          <v:PetView DataContext="{Binding ViewModels[Pet]}" Visibility="Hidden" />
          <v:WorkView DataContext="{Binding ViewModels[Work]}" Visibility="Hidden" />
          <v:MoveView DataContext="{Binding ViewModels[Move]}" Visibility="Hidden" />
          <v:AnimeView DataContext="{Binding ViewModels[Anime]}" Visibility="Hidden" />
        </Grid>
      </Grid>
      <Grid
        HorizontalAlignment="Right"
        Margin="-15,0,-15,0"
        x:Name="Grid_Collapse"
        Height="150"
        Width="30"
      >
        <ToggleButton
          x:Name="ToggleButton_Collapse"
          Width="20"
          Height="100"
          Opacity="0.2"
          Padding="0"
          d:IsChecked="False"
          Foreground="{DynamicResource PrimaryText}"
          ToolTip="{ll:Str '折叠模组信息'}"
          pu:ToggleButtonHelper.CornerRadius="2"
          Click="ToggleButton_Collapse_Click"
          Style="{DynamicResource ThemedToggleButtonStyle}"
        >
          <ToggleButton.Content>
            <TextBlock FontSize="16" Text="《" Width="20" Height="22" />
          </ToggleButton.Content>
          <pu:ToggleButtonHelper.CheckedContent>
            <TextBlock FontSize="16" Text="》" Width="12" Height="22" />
          </pu:ToggleButtonHelper.CheckedContent>
        </ToggleButton>
      </Grid>
    </Grid>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Button
        Height="30"
        Command="{Binding AddCultureCommand}"
        Content="{ll:Str 添加文化}"
        Style="{StaticResource ModMaker_ButtonBaseStyle}"
      />
      <ListBox
        x:Name="ListBox_Cultures"
        Grid.Row="1"
        pu:ScrollBarHelper.Background="{DynamicResource SecondaryLight}"
        pu:ScrollViewerHelper.ScrollBarThickness="5"
        pu:ScrollViewerHelper.ScrollBarPosition="Inside"
        d:ItemsSource="{d:SampleData ItemCount=5}"
        pu:ListBoxHelper.ItemsHoverBackground="{StaticResource SecondaryLight}"
        ItemsSource="{Binding ModInfo.I18nResource.ObservableCultures}"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        SelectedItem="{Binding ModInfo.I18nResource.CurrentCulture}"
        Style="{DynamicResource SideMenuListBoxStyle}"
      >
        <ListBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
            <Setter
              Property="Tag"
              Value="{Binding DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
            />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContextMenu">
              <Setter.Value>
                <ContextMenu>
                  <MenuItem
                    Command="{Binding PlacementTarget.Tag.EditCultureCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}"
                    Header="{ll:Str 修改语言}"
                  />
                  <MenuItem
                    Command="{Binding PlacementTarget.Tag.RemoveCultureCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}"
                    CommandParameter="{Binding}"
                    Header="{ll:Str 删除语言}"
                  />
                </ContextMenu>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <StackPanel Grid.Row="2">
        <Button
          Command="{Binding OpenModPathCommand}"
          Content="{ll:Str 打开所在的文件夹}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          Command="{Binding EditI18nCommand}"
          Content="{ll:Str 编辑多语言内容}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          Command="{Binding SaveCommand}"
          Content="{ll:Str 保存}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          Command="{Binding SaveToCommand}"
          Content="{ll:Str 保存至}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
        <Button
          Command="{Binding SaveAsTranslationModCommand}"
          Content="{ll:Str 保存为翻译模组}"
          Style="{StaticResource ModMaker_ButtonBaseStyle}"
        />
      </StackPanel>
    </Grid>
  </Grid>
</pu:WindowX>
