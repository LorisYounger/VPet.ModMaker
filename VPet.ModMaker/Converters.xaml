<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="https://hkw.com/wpf/converters"
  xmlns:local="clr-namespace:VPet.ModMaker"
>
  <c:MarginMultiConverter x:Key="MarginConverter" />
  <c:MarginMultiConverter x:Key="RatioMarginConverter" HasRatio="True" />
  <c:CalculatorMultiConverter NumberType="Double" x:Key="DoubleCalculatorConverter" />
  <c:StringFormatMultiConverter x:Key="StringFormatConverter" ReplaceUnsetValue="null" />
  <c:SolidColorBrushToMediaColorConverter x:Key="SolidColorBrushToMediaColorConverter" />
  <!--<c:MaxConverter x:Key="MaxConverter" />-->
  <c:BoolToVisibilityConverter x:Key="FalseToCollapsedConverter" />
  <c:FirstEqualsSecondMultiConverter x:Key="EqualsConverter" />
  <c:FirstEqualsSecondMultiConverter x:Key="NotEqualsConverter" IsInverted="True" />
  <local:NullToTrueConverter x:Key="NullToFalseConverter" IsInverted="True" />
  <c:AllBoolToVisibilityMultiConverter
    x:Key="AllTrueToCollapsedConverter"
    DefaultResult="Collapsed"
    FalseValue="Visible"
    TrueValue="Collapsed"
  />
  <c:BoolInverteConverter x:Key="BoolInverter" />
  <c:EnumToEnumInfoConverter x:Key="EnumToEnumInfoConverter" />
  <c:EnumsToEnumInfosConverter x:Key="EnumsToEnumInfosConverter" OnlyValid="True" />
  <c:CalculatorMultiConverter
    NumberType="Int32"
    x:Key="Int32CalculatorMultiConverter"
    DefaultResult="{x:Null}"
    ResultToString="True"
  />
  <c:EqualsToVisibilityConverter
    x:Key="NullToVisibleConverter"
    TrueValue="Hidden"
    FalseValue="Hidden"
    NullValue="Visible"
  />
</ResourceDictionary>
